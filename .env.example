# 🤖 Telegram Bot Configuration
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 🌐 App URL
# The URL where your Mini App is hosted (used for the "Open Dashboard" button)
APP_URL=https://t.me/your_bot_username/app

# 🧠 Google Gemini AI
# Required for analyzing food photos and text descriptions
# Get it from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 🗄️ Supabase Database
# Required for storing users and meal logs
# Get these from your Supabase project settings: https://supabase.com/
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 🍎 FatSecret API (Optional)
# Used for barcode scanning and detailed food database lookups
# Get these from FatSecret Platform API: https://platform.fatsecret.com/
FATSECRET_CLIENT_ID=your_fatsecret_client_id_here
FATSECRET_CLIENT_SECRET=your_fatsecret_client_secret_here
